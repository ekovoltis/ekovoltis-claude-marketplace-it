#!/usr/bin/env bash
# Uruchamia hook w Pythonie. Kazdy kod rozny od 0 (brak Pythona, wyjatek przed blokiem try,
# zabity interpreter) zamienia na 2, co dla PreToolUse oznacza odmowe (fail closed).
# UserPromptSubmit przy awarii blokuje tylko wiadomosci z akceptacja albo odwolaniem:
# nieudane odwolanie, o ktorym czlowiek nie wie, zostawiloby wazna akceptacje.
# Tylko polecenia wbudowane basha: przy braku PATH (test 7) nie ma cat ani grep.
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SCRIPT="$DIR/$1.py"
# Claude Code wymienia z hookami JSON w UTF-8, a Python na Windows domyslnie uzywa cp1252
# i wywraca sie na polskich znakach (tu: odmowa, a akceptacja sie nie rejestruje).
export PYTHONIOENCODING=utf-8
# Git Bash zamienia wartosci zaczynajace sie od "/" na sciezki Windows ("/sites/X" -> "C:/.../Git/sites/X").
export MSYS2_ENV_CONV_EXCL=CLAUDE_PLUGIN_OPTION_
IFS= read -r -d '' INPUT || true

refuse() {
  if [ "$1" = "hook_prompt" ]; then
    shopt -s nocasematch
    if ! [[ $INPUT =~ AKCEPTUJ|ODWO ]]; then
      echo "pp-support: hook akceptacji nie dziala ($2). Ta wiadomosc nie zmienia akceptacji." >&2
      exit 0
    fi
  fi
  echo "pp-support: $2, operacja zablokowana zapobiegawczo." >&2
  exit 2
}

for c in python3 python "py -3"; do
  if $c -c "import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)" >/dev/null 2>&1; then
    printf '%s' "$INPUT" | $c "$SCRIPT"
    rc=${PIPESTATUS[1]}
    [ "$rc" -eq 0 ] && exit 0
    refuse "$1" "blad hooka $1 (kod $rc)"
  fi
done
refuse "$1" "brak Pythona 3.9+ (zainstaluj, aby odblokowac)"
